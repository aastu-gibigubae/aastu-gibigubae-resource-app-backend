{
  "name": "aastu-gibigubae-resource-app-backend",
  "version": "1.0.0",
  "description": "Express + TypeScript REST API powering the AASTU Gibi Gubae freshman course resource app.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "dotenv -e .env.test -- vitest run --config vitest.integration.config.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aastu-gibigubae/aastu-gibigubae-resource-app-backend.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/aastu-gibigubae/aastu-gibigubae-resource-app-backend/issues"
  },
  "homepage": "https://github.com/aastu-gibigubae/aastu-gibigubae-resource-app-backend#readme",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1117.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "bcryptjs": "^3.0.3",
    "express": "^5.2.1",
    "file-type": "^22.0.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "node-cron": "^4.2.1",
    "pg": "^8.23.0",
    "prisma": "^7.9.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.2.0",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^3.2.4",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^8.0.0",
    "prettier": "^3.9.6",
    "ts-node-dev": "^2.0.0",
    "typescript": "^7.0.2",
    "vitest": "^3.2.4"
  }
}
