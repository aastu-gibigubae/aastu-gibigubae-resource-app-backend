# Copy this to .env.test and fill in a REAL but SEPARATE test database —
# a dedicated Neon branch or a separate Neon project, per the DB
# design doc's own testing strategy. NEVER point this at the same
# database as your real .env — integration tests genuinely insert,
# update, and delete rows.
#
# .env.test is gitignored, same as .env — never commit real values here.

DATABASE_URL="postgresql://USER:PASSWORD@YOUR-TEST-BRANCH.neon.tech/neondb?sslmode=require"

# Every other var integration tests transitively need at import time
# (via config/env.ts's validation) — same requirements as your real
# .env, just duplicated here so integration tests don't depend on your
# real .env existing alongside this one.
JWT_ACCESS_SECRET="test-access-secret-at-least-32-characters-long"
JWT_REFRESH_SECRET="test-refresh-secret-at-least-32-characters-long"
R2_ACCOUNT_ID="test-account-id"
R2_ACCESS_KEY_ID="test-access-key-id"
R2_SECRET_ACCESS_KEY="test-secret-access-key"
R2_BUCKET_NAME="test-bucket"
R2_PUBLIC_URL="https://files.test.example.com"